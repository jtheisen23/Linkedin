# Copy to .env and fill in from your browser while logged in to linkedin.com:
# DevTools -> Application (Chrome) / Storage (Firefox) -> Cookies -> https://www.linkedin.com
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
# Optional but recommended: the exact user agent of the browser you copied the cookies from.
# In that browser's DevTools console run: navigator.userAgent
LINKEDIN_USER_AGENT=
